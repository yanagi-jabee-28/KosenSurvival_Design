    "scene_open": {
      "id": "scene_open",
      "title": "Opening - New Semester",
      "background": "/assets/backgrounds/classroom.png",
      "characters": [],
      "messages": [
        {
          "characterName": "narrator",
          "text": "4月。新年度が始まった。",
          "speed": "normal"
        },
        {
          "characterName": "narrator",
          "text": "今日は期待と不安が入り混じる朝だ。校舎のあちこちで、新しい顔が目に入る。",
          "speed": "normal"
        },
        {
          "characterName": "narrator",
          "text": "作業室では工具を抱えた少女が、図書館では紙の山に埋もれた少女が、ネットワーク演習室では怪しいログを追う先輩がいる。学生会室では会議が始まり、寮の片隅には異様な佇まいの先輩もいる。",
          "speed": "normal"
        },
        {
          "characterName": "narrator",
          "text": "どこに向かう？",
          "speed": "normal"
        }
      ],
      "choices": {
        "choiceId": "choice_open_01",
        "choices": [
          {
            "id": "choice_a",
            "label": "作業室でロボットを弄る少女（赤坂 ミナ）に声をかける",
            "nextSceneId": "scene_A1"
          },
          {
            "id": "choice_b",
            "label": "図書館で論文に没頭する少女（一ノ瀬 アイ）に話しかける",
            "nextSceneId": "scene_B1"
          },
          {
            "id": "choice_c",
            "label": "ネット演習室で怪しいログを見ている先輩（諏訪野 レン）を覗く",
            "nextSceneId": "scene_C1"
          },
          {
            "id": "choice_d",
            "label": "学生会室で会議する神楽 マイに関わる",
            "nextSceneId": "scene_D1"
          },
          {
            "id": "choice_e",
            "label": "寮の影にいる不思議な先輩（室井 禅）を訪ねる",
            "nextSceneId": "scene_E1"
          }
        ]
      },
      "nextSceneId": null
    },

