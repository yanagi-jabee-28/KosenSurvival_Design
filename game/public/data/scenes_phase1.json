      "choices": null,
      "nextSceneId": "scene_common_end"
    },

    "scene_B1": {
      "id": "scene_B1",
      "title": "B: Library - Meeting Ai",
      "background": "",
      "characters": [
        {
          "name": "ai",
          "expression": "normal",
          "position": "center",
          "scale": 1.0,
          "opacity": 1.0
        }
      ],
      "messages": [
        {
          "characterName": "narrator",
          "text": "図書館の窓際で、一ノ瀬 アイが資料に集中している。周りは静かで、ページをめくる音だけが聞こえる。",
          "speed": "normal"
        },
        {
          "characterName": "一ノ瀬 アイ",
          "text": "一ノ瀬 アイです。よろしく。",
          "speed": "normal",
          "isIntroduction": true
        },
        {
          "characterName": "一ノ瀬 アイ",
          "text": "……何か用ですか？ 今、計算中なのですが。",
          "speed": "normal"
        }
      ],
      "choices": {
        "choiceId": "choice_B1",
        "choices": [
          {
            "id": "choice_B_talk",
            "label": "声をかける",
            "nextSceneId": "scene_B2_talk"
          },
          {
            "id": "choice_B_leave",
            "label": "そっと離れる",
            "nextSceneId": "scene_B2_leave"
          }
        ]
      },
      "nextSceneId": null
    },

    "scene_B2_talk": {
      "id": "scene_B2_talk",
      "title": "B: Library - Talk",
      "background": "",
      "characters": [
        {
          "name": "ai",
          "expression": "surprised",
          "position": "center",
          "scale": 1.0,
          "opacity": 1.0
        }
      ],
      "messages": [
        {
          "characterName": "一ノ瀬 アイ",
          "text": "情報系に興味があるのですか。要点だけで構いません。どこに興味があるのですか？",
          "speed": "normal"
        },
        {
          "characterName": "narrator",
          "text": "簡潔な会話から、少し距離が縮んだように感じた。",
          "speed": "normal"
        }
      ],
      "choices": null,
      "nextSceneId": "scene_common_end"
    },

    "scene_B2_leave": {
      "id": "scene_B2_leave",
