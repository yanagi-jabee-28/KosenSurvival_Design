  "scenes": {
    "scene_open": {
      "id": "scene_open",
      "title": "Opening - New Semester",
      "background": "",
      "characters": [],
      "messages": [
        {
          "characterName": "narrator",
          "text": "4月の朝。校舎には新学期の空気が満ちている。",
          "speed": "normal"
        },
        {
          "characterName": "narrator",
          "text": "人の出入りや下駄箱の音が聞こえる。緊張もあるが、どこか期待も混じっている。",
          "speed": "normal"
        },
        {
          "characterName": "narrator",
          "text": "作業室では黙々と工具を動かす人がいて、図書館ではページをめくる音がする。ネット演習室のモニタは薄く光り、学生会室は話し声で活気づいている。寮の片隅には少し変わった先輩の姿も見える。",
          "speed": "normal"
        },
        {
          "characterName": "narrator",
          "text": "さて、どこに向かおうか。",
          "speed": "normal"
        }
      ],
      "choices": {
        "choiceId": "choice_open_01",
        "choices": [
          {
            "id": "choice_a",
            "label": "作業室でロボットを弄る少女（赤坂 ミナ）に声をかける",
            "nextSceneId": "scene_A1"
          },
          {
            "id": "choice_b",
            "label": "図書館で論文に没頭する少女（一ノ瀬 アイ）に話しかける",
            "nextSceneId": "scene_B1"
          },
          {
            "id": "choice_c",
            "label": "ネット演習室で怪しいログを見ている先輩（諏訪野 レン）を覗く",
            "nextSceneId": "scene_C1"
          },
          {
            "id": "choice_d",
            "label": "学生会室で会議する神楽 マイに関わる",
            "nextSceneId": "scene_D1"
          },
          {
            "id": "choice_e",
            "label": "寮の影にいる不思議な先輩（室井 禅）を訪ねる",
            "nextSceneId": "scene_E1"
          }
        ]
      },
      "nextSceneId": null
    },

    "scene_A1": {
      "id": "scene_A1",
      "title": "A: Workshop - Meeting Mina",
      "background": "",
      "characters": [
        {
          "name": "mina",
          "expression": "working",
          "position": "center",
          "scale": 1.0,
          "opacity": 1.0
        }
      ],
      "messages": [
        {
          "characterName": "narrator",
          "text": "放課後の作業室は工具の音と油の匂いがする。机の上ではサーボが組み立て中だ。",
          "speed": "normal"
        },
        {
          "characterName": "赤坂 ミナ",
          "text": "赤坂 ミナだよ。よろしく。",
          "speed": "normal",
          "isIntroduction": true
        },
        {
          "characterName": "赤坂 ミナ",
          "text": "おう、来たのか？ 今サーボの調整中なんだ。手伝ってくれる？",
          "speed": "normal"
        }
      ],
      "choices": {
        "choiceId": "choice_A1",
        "choices": [
          {
            "id": "choice_A_help",
            "label": "手伝う",
            "nextSceneId": "scene_A2_help"
          },
          {
            "id": "choice_A_watch",
            "label": "見学する",
            "nextSceneId": "scene_A2_watch"
          }
        ]
      },
      "nextSceneId": null
    },

    "scene_A2_help": {
      "id": "scene_A2_help",
      "title": "A: Workshop - Help",
      "background": "",
      "characters": [
        {
          "name": "mina",
          "expression": "happy",
          "position": "center",
          "scale": 1.0,
          "opacity": 1.0
        }
      ],
      "messages": [
        {
          "characterName": "赤坂 ミナ",
          "text": "おう、助かった！ 動きが良くなったぞ。サンキュー！",
          "speed": "normal"
        },
        {
          "characterName": "narrator",
          "text": "短い共同作業で、互いにいい印象が残った。",
          "speed": "normal"
        }
      ],
      "choices": null,
      "nextSceneId": "scene_common_end"
    },

    "scene_A2_watch": {
      "id": "scene_A2_watch",
      "title": "A: Workshop - Watch",
      "background": "",
      "characters": [
        {
          "name": "mina",
          "expression": "normal",
          "position": "center",
          "scale": 1.0,
          "opacity": 1.0
