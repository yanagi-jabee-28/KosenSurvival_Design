      "messages": [
        {
          "characterName": "narrator",
          "text": "演習室のモニタが薄く光る。先輩がログをじっと見ている。",
          "speed": "normal"
        },
        {
          "characterName": "諏訪野 レン",
          "text": "諏訪野 レンだ。よろしく。",
          "speed": "normal",
          "isIntroduction": true
        },
        {
          "characterName": "諏訪野 レン",
          "text": "……面白そうなログだな。覗くか？ 興味があるなら教えてやる。",
          "speed": "normal"
        }
      ],
      "choices": {
        "choiceId": "choice_C1",
